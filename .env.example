# GrowMate Environment Configuration
# Copy this to .env and fill in your values before running install.sh
# The install script sources .env automatically if present.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   sudo ./scripts/install.sh
#
# For runtime secrets (DEVICE_API_KEY, DEVICE_ID), set them via:
#   sudo systemctl edit growmate
# Or they will be read from the environment at process start.

# ── Device Identity ──────────────────────────────────────────────────────────
# Unique device identifier sent to the API. Auto-generated from wlan0 MAC
# if not set (e.g. "growmate-aa1234bb5678").
# Runtime env: read at every process start from os.environ.
DEVICE_ID="growmate-my-device"

# ── API Configuration ────────────────────────────────────────────────────────
# Backend endpoint for sensor data uploads.
# GROWMATE_API_SENSOR_URL="https://growmate.bond/api/v2/sensors"

# Backend endpoint for camera stream registration.
# GROWMATE_API_STREAM_REGISTER_URL="https://growmate.bond/api/v2/stream/register"

# API key for x-api-key header on all requests.
# Runtime env: read at every process start from os.environ.
# DEVICE_API_KEY="your-api-key-here"

# ── Network / WiFi ───────────────────────────────────────────────────────────
# SSID and password for the target WiFi network (set during onboarding portal).
# These are normally empty on fresh install and filled by the AP-mode web portal.
# GROWMATE_NETWORK_WIFI_SSID="MyHomeWiFi"
# GROWMATE_NETWORK_WIFI_PASSWORD="hunter2"

# ── AP Mode (Onboarding) ─────────────────────────────────────────────────────
# Password for the device's own WiFi access point used during first-time setup.
# Default: "growmate"
# GROWMATE_AP_MODE_PASSWORD="changeme"

# ── Sensor Configuration ─────────────────────────────────────────────────────
# Enable DHT22 temperature/humidity sensor. Default: true.
# GROWMATE_SENSORS_ENABLE_DHT22="true"

# GPIO pin for DHT22 data line. Default: 4.
# GROWMATE_SENSORS_DHT22_PIN="4"

# ADC I2C address (hex). Default: 0x48.
# GROWMATE_SENSORS_ADC_I2C_ADDRESS="0x48"

# ADC gain setting. Default: 1.
# GROWMATE_SENSORS_ADC_GAIN="1"

# Sensor reading interval in seconds. Default: 60.
# GROWMATE_INTERVALS_SENSOR_READING="60"

# ── Actuator (Relay) GPIO Pins ───────────────────────────────────────────────
# GPIO pin for pump relay. Default: 10.
# GROWMATE_ACTUATORS_PINS_PUMP="10"

# GPIO pin for fertilizer relay. Default: 17.
# GROWMATE_ACTUATORS_PINS_FERTILIZER="17"

# GPIO pin for pesticide relay. Default: 27.
# GROWMATE_ACTUATORS_PINS_PESTICIDE="27"

# ── Limit Switch GPIO Pins ───────────────────────────────────────────────────
# GPIO pin for tank empty limit switch. Default: 20.
# GROWMATE_SENSORS_LIMIT_SWITCHES_TANK_GPIO="20"

# GPIO pin for drawer open limit switch. Default: 21.
# GROWMATE_SENSORS_LIMIT_SWITCHES_DRAWER_GPIO="21"

# ── Camera ───────────────────────────────────────────────────────────────────
# Enable rpicam-vid camera stream. Default: true.
# GROWMATE_CAMERA_ENABLED="true"

# ── Timing & Intervals ───────────────────────────────────────────────────────
# Failure monitor check interval in seconds. Default: 30.
# GROWMATE_INTERVALS_FAILURE_MONITOR="30"

# Camera watchdog check interval in seconds. Default: 30.
# GROWMATE_INTERVALS_CAMERA_WATCHDOG="30"

# Queue cleanup interval in seconds. Default: 3600 (1 hour).
# GROWMATE_INTERVALS_QUEUE_CLEANUP="3600"

# Health check interval in seconds. Default: 300 (5 minutes).
# GROWMATE_INTERVALS_HEALTH_CHECK="300"

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
# GROWMATE_LOGGING_LEVEL="INFO"

# Log format: json or text. Default: json.
# GROWMATE_LOGGING_FORMAT="json"

# ── Tailscale (Install-time Only) ────────────────────────────────────────────
# Pre-authenticated auth key for non-interactive Tailscale setup.
# Generate one at https://login.tailscale.com/admin/settings/authkeys
# If not set, install.sh will try interactive auth (may hang if non-TTY).
TAILSCALE_AUTH_KEY=""

# ── Features ─────────────────────────────────────────────────────────────────
# Enable offline queue for sensor data when disconnected. Default: true.
# GROWMATE_FEATURES_OFFLINE_QUEUE="true"

# Enable hot-reload of config changes without restart. Default: true.
# GROWMATE_FEATURES_HOT_RELOAD="true"

# Enable circuit breaker for API calls. Default: true.
# GROWMATE_FEATURES_CIRCUIT_BREAKER="true"

# ── Generic Override Pattern ─────────────────────────────────────────────────
# Any config key in the YAML can be overridden at runtime via:
#   GROWMATE_<SECTION>_<KEY>    (all uppercase, dots replaced with underscores)
# Examples:
#   GROWMATE_RETRY_MAX_ATTEMPTS="10"
#   GROWMATE_CIRCUIT_BREAKER_FAILURE_THRESHOLD="3"
#   GROWMATE_QUEUE_MAX_AGE_HOURS="48"
#   GROWMATE_UPLOAD_PROCESSOR_MAX_CONCURRENT="5"
