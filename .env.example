# GrowMate Environment Configuration
# Copy this to .env and fill in your values before running install.sh
#
# Usage:
#   cp .env.example .env
#   nano .env              # set your values
#   sudo ./scripts/install.sh
#
# Python deps come from apt (pre-compiled).
# Only 4 packages installed via pip (all pure-Python wheels).
#
# ── Required Secrets ──────────────────────────────────────────────────────────
# These have NO default and MUST be set for the device to function.
# After install, set them via:
#   sudo systemctl edit growmate
#   [Service]
#   Environment=DEVICE_API_KEY=<key>
#   Environment=DEVICE_ID=<id>

# API key for x-api-key header on all requests.
# Runtime: read from os.environ at every process start.
DEVICE_API_KEY=""

# Unique device identifier (short lowercase, e.g. "iaft01").
# If empty, auto-derived from wlan0 MAC as lowercase (no prefix).
# Runtime: read from os.environ at every process start; prepended with "growmate-".
DEVICE_ID=""

# ── Tailscale Auth (Install-time Only) ───────────────────────────────────────
# Pre-authenticated key for non-interactive Tailscale setup.
# If unset, install.sh will prompt for interactive `tailscale up`.
TAILSCALE_AUTH_KEY=""

# ── Install Defaults (applied during install.sh, written to config.yaml) ─────
# These can be set in .env to skip interactive prompts during install.
# They are NOT read at runtime — after install, use config.yaml or GROWMATE_*.

SENSOR_URL="https://growmate.bond/api/v2/sensors"
STREAM_URL="https://growmate.bond/api/v2/stream/register"
AP_PASS="changeme"
SENSOR_INTERVAL=60
DHT22=true
DHT22_PIN=4
ADC_ADDR=0x48
ADC_GAIN=1
PUMP_PIN=10
FERT_PIN=17
PEST_PIN=27
TANK_PIN=20
DRAWER_PIN=21
CAM_ENABLED=true
LOG_LEVEL=INFO

# ── Runtime Overrides (GROWMATE_* pattern, optional) ──────────────────────────
# Any config.yaml key can be overridden at runtime via:
#   GROWMATE_<SECTION>_<KEY>  (uppercase, dots → underscores)
#
# Examples:
#   GROWMATE_API_SENSOR_URL="https://growmate.bond/api/v2/sensors"
#   GROWMATE_API_STREAM_REGISTER_URL="https://growmate.bond/api/v2/stream/register"
#   GROWMATE_NETWORK_WIFI_SSID="MyHomeWiFi"
#   GROWMATE_NETWORK_WIFI_PASSWORD="hunter2"
#   GROWMATE_AP_MODE_PASSWORD="changeme"
#   GROWMATE_SENSORS_ENABLE_DHT22="true"
#   GROWMATE_SENSORS_DHT22_PIN="4"
#   GROWMATE_SENSORS_ADC_I2C_ADDRESS="0x48"
#   GROWMATE_SENSORS_ADC_GAIN="1"
#   GROWMATE_INTERVALS_SENSOR_READING="60"
#   GROWMATE_ACTUATORS_PINS_PUMP="10"
#   GROWMATE_ACTUATORS_PINS_FERTILIZER="17"
#   GROWMATE_ACTUATORS_PINS_PESTICIDE="27"
#   GROWMATE_SENSORS_LIMIT_SWITCHES_TANK_GPIO="20"
#   GROWMATE_SENSORS_LIMIT_SWITCHES_DRAWER_GPIO="21"
#   GROWMATE_CAMERA_ENABLED="true"
#   GROWMATE_INTERVALS_FAILURE_MONITOR="30"
#   GROWMATE_INTERVALS_CAMERA_WATCHDOG="30"
#   GROWMATE_INTERVALS_QUEUE_CLEANUP="3600"
#   GROWMATE_INTERVALS_HEALTH_CHECK="300"
#   GROWMATE_LOGGING_LEVEL="INFO"
#   GROWMATE_LOGGING_FORMAT="json"
#   GROWMATE_FEATURES_OFFLINE_QUEUE="true"
#   GROWMATE_FEATURES_HOT_RELOAD="true"
#   GROWMATE_FEATURES_CIRCUIT_BREAKER="true"
#   GROWMATE_RETRY_MAX_ATTEMPTS="6"
#   GROWMATE_CIRCUIT_BREAKER_FAILURE_THRESHOLD="5"
#   GROWMATE_QUEUE_MAX_AGE_HOURS="24"
#   GROWMATE_UPLOAD_PROCESSOR_MAX_CONCURRENT="3"
